# ── HuggingFace ───────────────────────────────
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxx

# ── Sécurité API ─────────────────────────────
# Génère avec : openssl rand -hex 32
API_KEY=change_moi_avec_une_cle_forte

# ── CORS ─────────────────────────────────────
# Plusieurs origines : séparées par des virgules. "*" refusé en production
# Prod : https://ton-domaine.com
ALLOWED_ORIGIN=http://localhost:3000

# ── Base de données ──────────────────────────
# Dev  : sqlite:///./fasoconnect.db
# Prod : postgresql://user:pass@host:5432/fasoconnect
DATABASE_URL=sqlite:///./fasoconnect.db

# ── Cache & timeout ──────────────────────────
CACHE_TTL=3600
INFER_TIMEOUT=60

# ── Environnement ────────────────────────────
# production (défaut) : refuse de démarrer sans API_KEY ou avec ALLOWED_ORIGIN=*
# dev                 : tolère les deux (avertissement)
APP_ENV=production

# ── Redis / inférence ────────────────────────
REDIS_URL=redis://redis:6379/0
CACHE_MAX_BYTES=1500000
INFER_CONCURRENCY=1
QUEUE_TIMEOUT=15
# entrées d'historique max par session (409 au-delà)
HISTORY_MAX_ENTRIES=1000
# all | none | moore,dioula,...
TTS_PRELOAD=all

# ── Modèle fine-tuné ─────────────────────────
# Modèle de base : identique à celui de l'entraînement Kaggle
#   facebook/nllb-200-distilled-600M (défaut) | facebook/nllb-200-distilled-1.3B
# NLLB_BASE_MODEL=facebook/nllb-200-distilled-1.3B
# Défaut : <projet>/models/nllb-burkina-v1
# NLLB_ADAPTER_PATH=/app/models/nllb-burkina-v1

# ── Derrière un proxy ────────────────────────
# IPs des proxys de confiance (pour lire X-Forwarded-For)
# FORWARDED_ALLOW_IPS=172.19.0.1
